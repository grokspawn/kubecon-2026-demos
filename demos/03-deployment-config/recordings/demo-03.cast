[5.303, "o", "\r\n\u001b[1;35m### 1. Install with user-specified deployment configuration\u001b[0m\r\n\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig create namespace kubecon-demo-system --dry-run=client -o yaml | kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f -\u001b[0m\r\n"]
[0.070, "o", "namespace/kubecon-demo-system created\r\n"]
[0.002, "o", "\u001b[1;36m$ cat /Users/jordan/devel/kubecon-2026-demos/demos/03-deployment-config/manifests/clusterextension-configured.yaml\u001b[0m\r\n"]
[0.003, "o", "# Demo 3: user-specified deployment configuration.\r\n# Reuses demo 1's bundle (kubecon-demo-operator v0.1.0). Two\r\n# ClusterExtensions are applied in sequence:\r\n#   1. clusterextension-configured.yaml — valid inline deploymentConfig\r\n#      (env, resources, nodeSelector) merged into the rendered deployment.\r\n#   2. clusterextension-invalid.yaml — a field outside the supported\r\n#      subset (selector, deliberately excluded from the v0\r\n#      SubscriptionConfig-derived schema) is rejected by validation.\r\napiVersion: olm.operatorframework.io/v1\r\nkind: ClusterExtension\r\nmetadata:\r\n  name: kubecon-demo-operator\r\nspec:\r\n  namespace: kubecon-demo-system\r\n  source:\r\n    sourceType: OCIImage\r\n    ociImage:\r\n      ref: docker-registry.kubecon-demo-registry.svc.cluster.local:5000/bundles/kubecon-demo-operator-bundle:v0.1.0\r\n  config:\r\n    configType: Inline\r\n    inline:\r\n      deploymentConfig:\r\n        env:\r\n          - name: DEMO_GREETING\r\n            value: configured-by-the-user\r\n        resources:\r\n          l"]
[0.000, "o", "imits:\r\n            cpu: 200m\r\n            memory: 256Mi\r\n          requests:\r\n            cpu: 50m\r\n            memory: 64Mi\r\n        nodeSelector:\r\n          kubernetes.io/os: linux\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f /Users/jordan/devel/kubecon-2026-demos/demos/03-deployment-config/manifests/clusterextension-configured.yaml\u001b[0m\r\n"]
[0.054, "o", "clusterextension.olm.operatorframework.io/kubecon-demo-operator created\r\n"]
[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig wait --for=condition=Available clusterextension/kubecon-demo-operator --timeout=300s\u001b[0m\r\n"]
[0.945, "o", "clusterextension.olm.operatorframework.io/kubecon-demo-operator condition met\r\n"]
[0.003, "o", "\r\n\u001b[1;35m### 2. The rendered Deployment carries the user's values\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig -n kubecon-demo-system get deployment kubecon-demo-operator -o yaml | sed -n '/template:/,/volumes:/p'\u001b[0m\r\n"]
[0.064, "o", "  template:\r\n    metadata:\r\n      annotations:\r\n        alm-examples: |-\r\n          [\r\n            {\r\n              \"apiVersion\": \"demo.kubecon.io/v1alpha1\",\r\n              \"kind\": \"KubeconDemo\",\r\n              \"metadata\": {\r\n                \"name\": \"example\"\r\n              },\r\n              \"spec\": {\r\n"]
[0.000, "o", "                \"message\": \"hello kubecon\"\r\n              }\r\n            }\r\n          ]\r\n        capabilities: Basic Install\r\n        categories: Demo\r\n        containerImage: docker-registry.kubecon-demo-registry.svc.cluster.local:5000/operators/kubecon-demo-operator:v0.1.0\r\n"]
[0.000, "o", "        createdAt: \"2026-10-27T00:00:00Z\"\r\n"]
[0.000, "o", "        description: Minimal registry+v1 operator bundle used to demonstrate direct\r\n"]
[0.000, "o", "          bundle installation.\r\n"]
[0.000, "o", "        olm.operatorNamespace: kubecon-demo-system\r\n        olm.properties: '[{\"type\":\"olm.package\",\"value\":{\"packageName\":\"kubecon-demo-operator\",\"version\":\"0.1.0\"}}]'\r\n        olm.targetNamespaces: \"\"\r\n        repository: https://github.com/grokspawn/kubecon-2026-demos\r\n        support: KubeCon Demo Team\r\n      labels:\r\n"]
[0.000, "o", "        app: kubecon-demo-operator\r\n    spec:\r\n      containers:\r\n      - command:\r\n"]
[0.000, "o", "        - /bin/sh\r\n"]
[0.000, "o", "        - -c\r\n"]
[0.000, "o", "        - |\r\n"]
[0.000, "o", "          echo \"kubecon-demo-operator v0.1.0 watching kubecondemos.demo.kubecon.io\"\r\n          while true; do sleep 30; done\r\n        env:\r\n        - name: DEMO_GREETING\r\n"]
[0.000, "o", "          value: configured-by-the-user\r\n"]
[0.000, "o", "        image: docker-registry.kubecon-demo-registry.svc.cluster.local:5000/operators/kubecon-demo-operator:v0.1.0\r\n        imagePullPolicy: IfNotPresent\r\n        livenessProbe:\r\n          exec:\r\n"]
[0.000, "o", "            command:\r\n            - /bin/sh\r\n"]
[0.000, "o", "            - -c\r\n            - echo alive\r\n          failureThreshold: 3\r\n          initialDelaySeconds: 5\r\n          periodSeconds: 15\r\n"]
[0.000, "o", "          successThreshold: 1\r\n"]
[0.000, "o", "          timeoutSeconds: 1\r\n"]
[0.000, "o", "        name: manager\r\n"]
[0.000, "o", "        resources:\r\n          limits:\r\n            cpu: 200m\r\n            memory: 256Mi\r\n          requests:\r\n            cpu: 50m\r\n            memory: 64Mi\r\n"]
[0.000, "o", "        terminationMessagePath: /dev/termination-log\r\n        terminationMessagePolicy: File\r\n      dnsPolicy: ClusterFirst\r\n"]
[0.000, "o", "      nodeSelector:\r\n"]
[0.000, "o", "        kubernetes.io/os: linux\r\n      restartPolicy: Always\r\n      schedulerName: default-scheduler\r\n      securityContext: {}\r\n      serviceAccount: kubecon-demo-operator\r\n      serviceAccountName: kubecon-demo-operator\r\n      terminationGracePeriodSeconds: 30\r\nstatus:\r\n  availableReplicas: 1\r\n  conditions:\r\n  - lastTransitionTime: \"2026-10-28T19:08:31Z\"\r\n    lastUpdateTime: \"2026-10-28T19:08:31Z\"\r\n    message: Deployment has minimum availability.\r\n    reason: MinimumReplicasAvailable\r\n    status: \"True\"\r\n    type: Available\r\n  - lastTransitionTime: \"2026-10-28T19:08:31Z\"\r\n    lastUpdateTime: \"2026-10-28T19:08:31Z\"\r\n    message: ReplicaSet \"kubecon-demo-operator-767bbbd78\" has successfully progressed.\r\n    reason: NewReplicaSetAvailable\r\n    status: \"True\"\r\n"]
[0.000, "o", "    type: Progressing\r\n  observedGeneration: 1\r\n  readyReplicas: 1\r\n  replicas: 1\r\n  terminatingReplicas: 0\r\n  updatedReplicas: 1\r\n"]
[0.002, "o", "\r\n\u001b[1;35m### 3. Unsupported configuration is rejected at reconcile with an explicit condition\u001b[0m\r\n"]
