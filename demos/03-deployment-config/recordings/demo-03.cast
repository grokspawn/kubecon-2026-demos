[5.010, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get clusterextension kubecon-demo-operator-invalid -o jsonpath='{.status.conditions}' | jq -c '[.[] | select(.type==\"Progressing\")]'\u001b[0m\r\n"]
