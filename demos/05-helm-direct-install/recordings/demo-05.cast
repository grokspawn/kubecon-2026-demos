[0.001, "o", "\r\n\u001b[1;35m### 4. Charts outside the supported subset are rejected with specific errors\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f /Users/jordan/devel/kubecon-2026-demos/demos/05-helm-direct-install/manifests/clusterextension-bad.yaml\u001b[0m\r\n"]
[0.051, "o", "clusterextension.olm.operatorframework.io/kubecon-chart-bad created\r\n"]
[5.011, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig get clusterextension kubecon-chart-bad -o jsonpath='{.status.conditions}' | jq -c '[.[] | select(.type==\"Progressing\")]'\u001b[0m\r\n"]
[0.080, "o", "\u001b[1;39m[\u001b[1;39m{\u001b[0m\u001b[1;34m\"lastTransitionTime\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"2026-10-28T19:08:40Z\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"error for resolved bundle \\\"kubecon-chart-bad.v0.1.0\\\" with version \\\"0.1.0\\\": template \\\"templates/random.yaml\\\" uses \\\"randAlphaNum\\\", which is not part of the supported deterministic rendering subset; produce stable output for stable inputs instead\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"observedGeneration\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39m1\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"reason\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Retrying\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"status\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"True\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"type\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Progressing\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\r\n"]
[0.000, "o", "\r\n\u001b[1;35m### 5. Cleanup removes the rendered content, including the CRD\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig delete clusterextension kubecon-chart-demo kubecon-chart-bad --ignore-not-found\u001b[0m\r\n"]
