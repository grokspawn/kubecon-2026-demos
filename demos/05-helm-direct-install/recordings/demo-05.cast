[0.308, "o", "\r\n\u001b[1;35m### 1. The install source is a standard chart OCI artifact\u001b[0m\r\n\u001b[1;36m$ skopeo inspect --raw --insecure-policy --tls-verify=false docker://localhost:55000/charts/kubecon-chart-demo:0.4.0 | jq .\u001b[0m\r\n"]
[0.118, "o", "\u001b[1;39m{\r\n  \u001b[0m\u001b[1;34m\"schemaVersion\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m2\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"mediaType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"application/vnd.oci.image.manifest.v1+json\"\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"config\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m{\r\n    \u001b[0m\u001b[1;34m\"mediaType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"application/vnd.oci.image.config.v1+json\"\u001b[0m\u001b[1;39m,\r\n"]
[0.000, "o", "    \u001b[0m\u001b[1;34m\"digest\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"sha256:2fa95cd2cd3df38eef115b2b307da6fdd1a88530ec833b7f2aaf08f909a5ffe2\"\u001b[0m\u001b[1;39m,\r\n    \u001b[0m\u001b[1;34m\"size\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m284\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m}\u001b[0m\u001b[1;39m,\r\n  \u001b[0m\u001b[1;34m\"layers\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[1;39m[\r\n"]
[0.000, "o", "    \u001b[1;39m{\r\n"]
[0.000, "o", "      \u001b[0m\u001b[1;34m\"mediaType\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"application/vnd.cncf.helm.chart.content.v1.tar+gzip\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"digest\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;32m\"sha256:05b37273c759b85422fb18c54eb7dcb12702a1f4b61c6a154e57467fb08e9bef\"\u001b[0m\u001b[1;39m,\r\n      \u001b[0m\u001b[1;34m\"size\"\u001b[0m\u001b[1;39m: \u001b[0m\u001b[0;39m1549\u001b[0m\u001b[1;39m\r\n    \u001b[1;39m}\u001b[0m\u001b[1;39m\r\n  \u001b[1;39m]\u001b[0m\u001b[1;39m\r\n\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;36m$ cat /Users/jordan/devel/kubecon-2026-demos/demos/05-helm-direct-install/chart/Chart.yaml\u001b[0m\r\n"]
[0.003, "o", "apiVersion: v2\r\nname: kubecon-chart-demo\r\ndescription: |\r\n  A deliberately small, self-contained Helm chart for demonstrating\r\n  direct chart installation through OLM: one CRD (in templates/, per the\r\n  helm+v2 content design), one deployment, one service account. No hooks,\r\n  no remote dependencies, deterministic templates only.\r\ntype: application\r\nversion: 0.4.0\r\nappVersion: \"0.4.0\"\r\n"]
[0.000, "o", "\u001b[1;36m$ ls /Users/jordan/devel/kubecon-2026-demos/demos/05-helm-direct-install/chart/templates/\u001b[0m\r\n"]
[0.003, "o", "crd.yaml\t\tdeployment.yaml\t\tserviceaccount.yaml\r\n"]
[0.001, "o", "\r\n\u001b[1;35m### 2. One ClusterExtension: chart ref plus inline values\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ cat /Users/jordan/devel/kubecon-2026-demos/demos/05-helm-direct-install/manifests/clusterextension-chart.yaml\u001b[0m\r\n"]
[0.002, "o", "# Direct chart installation: the same ClusterExtension sourceType as demo\r\n# 1, pointed at a standard Helm chart OCI artifact. Values arrive through\r\n# spec.config.inline — the same inline-config mechanism as demo 3.\r\napiVersion: olm.operatorframework.io/v1\r\nkind: ClusterExtension\r\nmetadata:\r\n  name: kubecon-chart-demo\r\nspec:\r\n  namespace: kubecon-chart-system\r\n  source:\r\n    sourceType: OCIImage\r\n    ociImage:\r\n      ref: docker-registry.kubecon-demo-registry.svc.cluster.local:5000/charts/kubecon-chart-demo:0.4.0\r\n  config:\r\n    configType: Inline\r\n    inline:\r\n      replicaCount: 2\r\n      greeting: configured-by-the-user\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig create namespace kubecon-chart-system --dry-run=client -o yaml | kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f -\u001b[0m\r\n"]
[0.076, "o", "namespace/kubecon-chart-system created\r\n"]
[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig apply -f /Users/jordan/devel/kubecon-2026-demos/demos/05-helm-direct-install/manifests/clusterextension-chart.yaml\u001b[0m\r\n"]
[0.047, "o", "clusterextension.olm.operatorframework.io/kubecon-chart-demo created\r\n"]
[0.002, "o", "\r\n\u001b[1;35m### 3. The chart renders and installs through OLM's lifecycle\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/agent-playground/kubecon-oc-direct-bundle/.kubeconfig/operator-controller-experimental-e2e.kubeconfig wait --for=condition=Available clusterextension/kubecon-chart-demo --timeout=300s\u001b[0m\r\n"]
