[0.000, "o", "0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"CSV health\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"phase: Succeeded, reason: InstallSucceeded\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"No scoped ServiceAccount\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"OperatorGroup does not use a scoped service account\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"No namespace selector\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"OperatorGroup does not use a namespace selector\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Upgrade strategy\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"upgrade strategy is Default or unset\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\""]
[0.000, "o", "name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"AllNamespaces mode\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"operator is in AllNamespaces mode\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"AllNamespaces install mode supported\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"CSV supports AllNamespaces install mode\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"No dependency resolution\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"no olm.package.required or olm.gvk.required properties\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"No APIService definitions\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"CSV does not define owned APIServices\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b["]
[0.001, "o", "1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"No OperatorCondition usage\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"OperatorCondition exists but has no status entries\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"OLMv0-API RBAC\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"CSV clusterPermissions do not grant OLMv0 API access\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m,\u001b[1;39m{\u001b[0m\u001b[1;34m\"name\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"Catalog availability\"\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"passed\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;39mtrue\u001b[0m\u001b[1;39m,\u001b[0m\u001b[1;34m\"message\"\u001b[0m\u001b[1;39m:\u001b[0m\u001b[0;32m\"package available in ClusterCatalog operatorhubio\"\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m]\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\u001b[1;39m\u001b[1;39m}\u001b[0m\r\n"]
[0.001, "o", "\u001b[1;36m$ jq -r 'select(.type==\"check\") | .data | \"\\(.package) \\(.version): \\(.status) - \\(.reason)\"' /tmp/migration-check.jsonl\u001b[0m\r\n"]
[0.004, "o", "ecr-secret-operator 0.6.0: Eligible - passes all readiness, compatibility, and catalog-availability checks\r\n"]
[0.000, "o", "\r\n\u001b[1;35m### 6. Convert the operator to OLMv1 management\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ /Users/jordan/devel/agent-playground/kubecon-library-olm/bin/migrate-operators-v0-to-v1 --kubeconfig /Users/jordan/devel/kubecon-2026-demos/demos/04-migration/.kubeconfig convert ecr-secret-operator -n migration-demo\u001b[0m\r\n"]
[0.011, "o", "\r\n\u001b[1m\u001b[36m🔄 Migrating migration-demo/ecr-secret-operator to OLMv1...\u001b[0m\r\n\r\n\u001b[1m\u001b[36mProfiling operator\u001b[0m\r\n"]
[0.017, "o", "  \u001b[32m✓\u001b[0m profile complete\r\n\r\n\u001b[1m\u001b[36mChecking readiness and compatibility\u001b[0m\r\n"]
[0.011, "o", "  \u001b[32m✓\u001b[0m check complete\r\n\r\n\u001b[1m\u001b[36mDetermining target ClusterCatalog\u001b[0m\r\n"]
[0.001, "o", "\r  \u001b[2mQuerying catalog operatorhubio for package ecr-secret-operator@0.6.0...\u001b[0m"]
[0.263, "o", "\r                                                                                \r  \u001b[32m✓\u001b[0m catalog complete\r\n\r\n\u001b[1m\u001b[36mCollecting and preflighting operator resources\u001b[0m\r\n"]
[0.079, "o", "  \u001b[32m✓\u001b[0m collect complete\r\n\r\n\u001b[1m\u001b[36mBacking up OLMv0 resources\u001b[0m\r\n"]
[0.003, "o", "  \u001b[32m✓\u001b[0m backup complete\r\n\r\n\u001b[1m\u001b[36mPreparing operator for migration\u001b[0m\r\n"]
[0.009, "o", "  TLS certificate management will transfer from OLMv0 to cert-manager/service-ca; expect pod restarts while new cert secrets are provisioned\r\n  \u001b[32m✓\u001b[0m prepare complete\r\n\r\n\u001b[1m\u001b[36mCreating OLMv1 migration resources\u001b[0m\r\n"]
[0.015, "o", "\r  \u001b[2mWaiting for ClusterObjectSet ecr-secret-operator-1 to reach Succeeded=True...\u001b[0m"]
[5.031, "o", "\r                                                                                \r\r  \u001b[2mWaiting for ClusterExtension ecr-secret-operator to reach Installed=True...\u001b[0m"]
[5.007, "o", "\r                                                                                \r  \u001b[32m✓\u001b[0m create complete\r\n\r\n\u001b[1m\u001b[36mCleaning up OLMv0 resources\u001b[0m\r\n"]
[0.020, "o", "  \u001b[32m✓\u001b[0m cleanup complete\r\n\r\n\u001b[1m\u001b[32m✅ Migration complete! ecr-secret-operator is now managed by OLMv1\u001b[0m\r\n\r\n"]
[0.006, "o", "\r\n\u001b[1;35m### 7. Verify the handoff\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/kubecon-2026-demos/demos/04-migration/.kubeconfig get clusterextension\u001b[0m\r\n"]
