[0.000, "o", "  \u001b[32m✓\u001b[0m Upgrade strategy                    \u001b[2mupgrade strategy is Default or unset\u001b[0m\r\n  \u001b[32m✓\u001b[0m AllNamespaces mode                  \u001b[2moperator is in AllNamespaces mode\u001b[0m\r\n  \u001b[32m✓\u001b[0m AllNamespaces install mode supported \u001b[2mCSV supports AllNamespaces install mode\u001b[0m\r\n  \u001b[32m✓\u001b[0m No dependency resolution            \u001b[2mno olm.package.required or olm.gvk.required properties\u001b[0m\r\n  \u001b[32m✓\u001b[0m No APIService definitions           \u001b[2mCSV does not define owned APIServices\u001b[0m\r\n  \u001b[32m✓\u001b[0m No OperatorCondition usage          \u001b[2mOperatorCondition exists but has no status entries\u001b[0m\r\n  \u001b[32m✓\u001b[0m OLMv0-API RBAC                      \u001b[2mCSV clusterPermissions do not grant OLMv0 API access\u001b[0m\r\n  \u001b[32m✓\u001b[0m Catalog availability                \u001b[2mpackage available in ClusterCatalog operatorhubio\u001b[0m\r\n"]
