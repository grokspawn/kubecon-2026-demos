[0.000, "o", "        "]
[0.000, "o", "True          5s\r\n"]
[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/kubecon-2026-demos/demos/04-migration/.kubeconfig -n migration-demo get clusterextension 2>/dev/null || true\u001b[0m\r\n"]
