[0.001, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/kubecon-2026-demos/demos/04-migration/.kubeconfig -n migration-demo get subscription,csv 2>/dev/null || echo 'OLMv0 Subscription and CSV are gone'\u001b[0m\r\n"]
[0.040, "o", "\u001b[1;36m$ kubectl --kubeconfig /Users/jordan/devel/kubecon-2026-demos/demos/04-migration/.kubeconfig -n migration-demo get deployment\u001b[0m\r\n"]
